# --- Jobber (booking form) ---
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=http://localhost:8888/.netlify/functions/jobber-auth-callback
JOBBER_API_VERSION=2025-04-16

# --- Stripe (gift cards) ---
# From Stripe Dashboard -> Developers -> API keys. Use the TEST secret key
# (sk_test_...) until you're ready to go live, then swap to sk_live_...
STRIPE_SECRET_KEY=
# From Stripe -> Developers -> Webhooks, the signing secret (whsec_...) for the
# endpoint you point at /.netlify/functions/gift-webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# --- Resend (recipient gift emails) ---
# From resend.com -> API Keys. Verify beehivedetailingco.com for best delivery.
RESEND_API_KEY=
# The "from" address recipients see (must be on a verified domain):
GIFT_FROM_EMAIL=gifts@beehivedetailingco.com
# Where replies go (optional; defaults to GIFT_FROM_EMAIL):
GIFT_REPLY_TO=beehivedetailco@gmail.com

# Optional: overrides the site URL used in email links (Netlify sets URL automatically)
# SITE_URL=https://beehivedetailingco.com
